{
  "name": "next-render-advisor",
  "version": "0.1.0",
  "description": "CLI that recommends Server vs Client Component and Static vs ISR vs Dynamic generation for Next.js App Router projects",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --filter next-render-advisor dev",
    "test": "pnpm -r test --passWithNoTests",
    "test:coverage": "pnpm -r test --coverage --passWithNoTests",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "lint": "eslint --no-error-on-unmatched-pattern packages/*/src packages/*/test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
